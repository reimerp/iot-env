# Gather fritzbox status
[[inputs.fritzbox]]
  ## URLs of the devices to query including login credentials
  urls = [ "http://monitor:iw@nttog3tmyfritzlogssoon@fritz.box:49000/" ]

  ## The information to collect (see README for further details).
  collect = [
    "device",
    "wan",
    #"ppp",
    #"dsl",
    "wlan",
  ]


[[inputs.snmp]]
  agents = ["udp://192.168.176.15:161"]
  version = 2
  community = "public"
  agent_host_tag = "source"
  [[inputs.snmp.field]]
    oid = "RFC1213-MIB::sysUpTime.0"
    name = "sysUptime"
    conversion = "float(2)"
  [[inputs.snmp.field]]
    oid = "RFC1213-MIB::sysName.0"
    name = "sysName"
    is_tag = true
  [[inputs.snmp.table]]
    oid = "IF-MIB::ifTable"
    name = "interface"
    inherit_tags = ["sysName"]
    [[inputs.snmp.table.field]]
     oid = "IF-MIB::ifDescr"
     name = "ifDescr"
     is_tag = true


# Read InfluxDB-formatted JSON metrics from one or more HTTP endpoints
